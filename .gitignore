# gradle

.gradle/
build/
out/
classes/

# ... but a java package may legitimately be called `build`, and an unanchored `build/` swallows it
# silently: org.betterx.betternether.world.tree.build went untracked this way, and a fresh clone of
# the repo did not compile.
!src/*/java/**/build/

